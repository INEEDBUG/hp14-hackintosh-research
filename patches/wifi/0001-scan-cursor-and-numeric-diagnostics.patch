+    unsigned count = ++wifiDiagnosticStageCount[stage];
+    unsigned long long sequence = ++wifiDiagnosticSequence;
+    if (count > 8 && (count % 64) != 0)
+        return;
+    IOLog("HP14WIFI v1 seq=%llu stage=%u status=%08x detail=%u state=%u flags=%08x scan=%u join=%u deferred=%u auth=%u\n",
+        sequence, stage, unsigned(status), detail, unsigned(ic->ic_state),
+        unsigned(ic->ic_flags), unsigned(scanPending), unsigned(joinPending),
+        unsigned(joinDeferred), unsigned(portAuthorized));
+#endif
+}
