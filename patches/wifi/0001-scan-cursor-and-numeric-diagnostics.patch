+#ifdef AIRPORT_WCL
+IOReturn AirportItlwmSkywalkInterface::getSCAN_RESULTGated(apple80211_scan_result *sr)
+{
+    if (fScanResultWrapping) {
+        resetScanCursor();
+        return 5;
+    }
+    auto ic = fHalService->get80211Controller();
+    ieee80211_node *node;
+    RB_FOREACH(node, ieee80211_tree, &ic->ic_tree) {
+        if (!scanCursorValid ||
+            memcmp(node->ni_macaddr, scanCursorMAC, IEEE80211_ADDR_LEN) > 0)
+            break;
+    }
+    if (!node) {
+        resetScanCursor();
+        return 5;
+    }
+    convertNodeToScanResult(fHalService, node, sr);
+    memcpy(scanCursorMAC, node->ni_macaddr, sizeof(scanCursorMAC));
+    scanCursorValid = true;
+    fScanResultWrapping = RB_NEXT(ieee80211_tree, &ic->ic_tree, node) == nullptr;
     return kIOReturnSuccess;
 }
+#endif
 
